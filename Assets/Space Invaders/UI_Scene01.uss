.screen {
	width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;   /* center horizontally */
    align-items: center;       /* center vertically */
}

.bigButton {
	background-color: #2c8cff;
    color: white;
    font-size: 40px;
    -unity-font-style: bold;

    /* rounded corners and no border */
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;

    /* scale relative to the .screen container */
    width: 30%;
    height: 12%;

    /* keep reasonable bounds */
    min-width: 200px;
    min-height: 60px;
    max-width: 420px;
    max-height: 120px;

    align-self: center;
}

.bigButton:hover {
	background-color: #58d68d;
}

.bigButton:active {
	background-color: #27ae60;
}

.smallButton {
	background-color: #27ae60;
    color: black;
    font-size: 40px;
    -unity-font-style: bold;

    /* rounded corners and no border */
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;

    /* scale relative to the .screen container */
    width: 30%;
    height: 12%;

    /* keep reasonable bounds */
    min-width: 100px;
    min-height: 30px;
    max-width: 210px;
    max-height: 60px;

    align-self: center;
}

.smallButton:hover {
	background-color: #58d68d;
}

.smallButton:active {
	background-color: #27ae60;
}